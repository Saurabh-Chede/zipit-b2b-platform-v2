# ==============================================================================
# FRONTEND (Vite / Vercel — Public Browser Variables ONLY, NEVER put secrets here)
# ==============================================================================
# Leave empty in monolithic mode (uses relative "/api/v1" and same-origin WebSocket).
# For separate frontend deployment (e.g. Vercel app.zipit.in -> Render api.zipit.in):
# VITE_API_URL="https://api.zipit.in"
# VITE_WS_URL="wss://api.zipit.in/ws/notifications"
VITE_API_URL=""
VITE_WS_URL=""

# ==============================================================================
# BACKEND RUNTIME & DEPLOYMENT MODE
# ==============================================================================
NODE_ENV="development"
PORT=3000
# Set "true" for monolithic mode (serves built frontend from dist/), "false" for backend-only API service (Render)
SERVE_FRONTEND="true"
APP_URL="http://localhost:3000"
# Comma-separated explicit allowed origins (wildcard "*" is rejected in production)
# Separate deployment example: CORS_ORIGIN="https://app.zipit.in"
CORS_ORIGIN="http://localhost:3000"

# ==============================================================================
# DATABASE
# ==============================================================================
# Leave empty ONLY in local development (auto-starts embedded MongoDB).
# REQUIRED MongoDB Atlas / Replica Set URI in production:
MONGODB_URI=""

# ==============================================================================
# SECURITY, AUTHENTICATION & CROSS-SUBDOMAIN COOKIES
# ==============================================================================
# Replace with strong 64-char random hex secrets in production (`openssl rand -hex 32`)
JWT_SECRET="CHANGE_ME_TO_A_SECURE_64_CHAR_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="CHANGE_ME_TO_A_SECURE_COOKIE_SECRET"
# Set ".zipit.in" when frontend (app.zipit.in) and backend (api.zipit.in) share the root domain.
# Leave empty in local development or monolithic single-domain deployments.
COOKIE_DOMAIN=""
# "auto" (default: Lax on localhost or shared COOKIE_DOMAIN subdomains; None over cross-site HTTPS),
# or explicitly "lax" | "none" | "strict"
COOKIE_SAME_SITE="auto"

# ==============================================================================
# FILE STORAGE (Local Disk or S3-Compatible Cloud Storage e.g. Cloudflare R2 / AWS S3)
# ==============================================================================
# "local" for local dev / persistent disk; "s3" for Cloudflare R2 / AWS S3
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads/delivery-proofs"

# Required when STORAGE_PROVIDER="s3"
S3_BUCKET=""
S3_REGION="auto"
# For Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com (leave empty for standard AWS S3)
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
S3_KEY_PREFIX="zipit-uploads"

# ==============================================================================
# RATE LIMITING & DEVELOPMENT SEEDING
# ==============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Keep "false" in production so demo accounts are not re-seeded on restarts
SEED_ON_STARTUP="true"

# ==============================================================================
# REAL-TIME ERROR & INCIDENT ALERTING
# ==============================================================================
DISCORD_ALERT_WEBHOOK_URL=""
ALERT_WEBHOOK_URL=""
# Alert sensitivity: "WARN" catches 4xx/5xx/UI errors; "ERROR" catches only 500+/FATAL
ALERT_MIN_LEVEL="WARN"

# ==============================================================================
# LIVE PAYMENT GATEWAY (Razorpay Standard Checkout & Webhook Verification)
# ==============================================================================
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ==============================================================================
# TRANSACTIONAL EMAIL (SMTP for Password Reset OTPs)
# ==============================================================================
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ZIPIT B2B Transport <noreply@zipit.in>"

# ==============================================================================
# META WHATSAPP BUSINESS CLOUD API (Automated Shipment Tracking Notifications)
# ==============================================================================
WHATSAPP_ENABLED="false"
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
